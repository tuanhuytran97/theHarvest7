            const sheetHist = ss.getSheetByName("InvestingHistoricalData");

            if (!sheetHist) {
                return returnJson({ "status": "init_required", "message": "Cần khởi tạo Sheet InvestingHistoricalData." });
            }

            const dataHist = sheetHist.getDataRange().getValues();
            return returnJson({ 
                "status": "success", 
                "history": dataHist
            });
        } else if (action === "save_investment_event") {
            const ss = SpreadsheetApp.getActiveSpreadsheet();
            const sheetHist = ss.getSheetByName("InvestingHistoricalData");
            if (!sheetHist) return returnJson({ "status": "error", "message": "Sheet chưa được khởi tạo!" });

            const headers = sheetHist.getRange(1, 1, 1, sheetHist.getLastColumn()).getValues()[0];
            const eventData = params.data;
            const row = headers.map(h => eventData[h] || "");
            sheetHist.appendRow(row);

            return returnJson({ "status": "success" });
        } else if (action === "update_investment_prices" || action === "update_external_prices") {
            const ss = SpreadsheetApp.getActiveSpreadsheet();
            const sheetHist = ss.getSheetByName("InvestingHistoricalData");
            if (!sheetHist) return returnJson({ "status": "error", "message": "Không tìm thấy Sheet InvestingHistoricalData." });

            const data = sheetHist.getDataRange().getValues();
            const headers = data[0];
            const colSymbol = headers.indexOf("Mã/Tên");
            const colCurrentPrice = headers.indexOf("Giá Hiện Tại");
            const colType = headers.findIndex(h => h.toLowerCase().includes("loại") || h.toLowerCase().includes("type"));

            if (colSymbol === -1 || colCurrentPrice === -1) 
                return returnJson({ "status": "error", "message": "Cấu trúc Sheet không đúng." });

            let updateCount = 0;
            const newPrices = params.prices || {}; // For external sync

            if (action === "update_investment_prices") {
                const symbolsToFetch = [];
                for (let i = 1; i < data.length; i++) {
                    const symbol = String(data[i][colSymbol] || "").trim().toUpperCase();
                    if (!symbol) continue;
                    const type = colType > -1 ? String(data[i][colType] || "").toLowerCase() : "";
                    if ((type.includes("phiếu") || type.includes("etf") || symbol.length === 3) && !symbolsToFetch.includes(symbol)) { 
                        symbolsToFetch.push(symbol);
                    }
                }
                
                if (symbolsToFetch.length > 0) {
                    const fetched = fetchVnStockPrices(symbolsToFetch);
                    Object.assign(newPrices, fetched);
                }
            }

            // Update all rows for the matching symbols
            for (let i = 1; i < data.length; i++) {
                const symbol = String(data[i][colSymbol] || "").trim().toUpperCase();
                if (newPrices[symbol]) {
                    sheetHist.getRange(i + 1, colCurrentPrice + 1).setValue(newPrices[symbol]);
                    updateCount++;
                }
            }

            return returnJson({ 
                "status": "success", 
                "message": "Đã cập nhật " + updateCount + " dòng.",
                "history": sheetHist.getDataRange().getValues() 
            });
        }

        // --- TODO LIST ACTIONS ---
        else if (action === "get_todo_data") {
            const todoSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(TODO_SHEET_NAME);
            if (!todoSheet) return returnJson({ "status": "error", "message": "Sheet ToDoTracker không tồn tại" });
            const todoData = todoSheet.getDataRange().getValues();
            
            // Convert Dates to strings to avoid timezone shift in JSON
            const formattedData = todoData.map(function(row) {
                return row.map(function(cell) {
                    if (Object.prototype.toString.call(cell) === '[object Date]') {
                        return Utilities.formatDate(cell, "GMT+7", "dd/MM/yyyy");
                    }
                    return cell;
                });
            });
            
            return returnJson({ "status": "success", "data": formattedData });

        } else if (action === "save_todo_task") {
            const todoSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(TODO_SHEET_NAME);
            if (!todoSheet) return returnJson({ "status": "error", "message": "Sheet ToDoTracker không tồn tại" });
            const todoData = todoSheet.getDataRange().getValues();
            const task = params.data;
            const taskId = task.id;
            
            let deadline = task.deadline || "";
            if (deadline && deadline.indexOf("-") > -1) {
                var p = deadline.split("-"); // YYYY-MM-DD
                deadline = p[2] + "/" + p[1] + "/" + p[0];
            }

            let rowIndex = -1;
            if (taskId) {
                for (let i = 1; i < todoData.length; i++) {
                    if (String(todoData[i][0]) === String(taskId)) {
                        rowIndex = i + 1;
                        break;
                    }
                }
            }
            
            if (todoData[0].length < 9) {
                todoSheet.getRange(1, 9).setValue("Sticker");
            }
            
            const now = Utilities.formatDate(new Date(), "GMT+7", "dd/MM/yyyy HH:mm:ss");
            const rowData = [
                taskId || "TD_" + new Date().getTime(),
                task.task || "",
                deadline,
                task.priority || "Trung bình",
                task.status || "Chưa bắt đầu",
                task.category || "",
                task.note || "",
                rowIndex > -1 ? (todoData[rowIndex-1][7] || now) : now,
                task.sticker || ""
            ];
            
            if (rowIndex > -1) {
                todoSheet.getRange(rowIndex, 1, 1, rowData.length).setValues([rowData]);
            } else {
                todoSheet.appendRow(rowData);
            }
            return returnJson({ "status": "success" });

        } else if (action === "delete_todo_task") {
            const todoSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(TODO_SHEET_NAME);
            if (!todoSheet) return returnJson({ "status": "error", "message": "Sheet ToDoTracker không tồn tại" });
            const todoData = todoSheet.getDataRange().getValues();
            const taskId = params.id;
            for (let i = 1; i < todoData.length; i++) {
                if (String(todoData[i][0]) === String(taskId)) {
                    todoSheet.deleteRow(i + 1);
                    return returnJson({ "status": "success" });
                }
            }
            return returnJson({ "status": "error", "message": "Không tìm thấy task" });
        }

    } catch (err) {
        return returnJson({ "status": "error", "message": err.toString() });
    }
}

