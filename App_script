// ─── MONTHLY LEDGER RECALCULATION ────────────────────────────────────────────

/**
 * Normalizes string for robust header comparison (lowercase, trimmed, no accents)
 */
function normalizeString(str) {
  if (!str) return "";
  return String(str)
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, ""); // Remove accents
}

/**
 * Finds column index by name (case-insensitive, accent-insensitive)
 */
function getColumnIdx(headers, name) {
  const normName = normalizeString(name);
  for (let i = 0; i < headers.length; i++) {
    if (normalizeString(headers[i]) === normName) return i;
  }
  return -1;
}

/**
 * Propagates cash balance from a specific date to the present (or future if date is ahead).
 * IMPORTANT: Never recalculates months before April 2026 to protect historical data.
 * PERFORMANCE: Reads sheet data ONCE using getValues() (no getDisplayValues()) and writes Cash column ONCE.
 * Pre-indexes all row indices by year-month to achieve O(N) performance on large data scales (25k+ rows).
 */
function recalculateFromDate(sheet, headers, date) {
    if (!date) return;

    // Hard cutoff: never touch data before 01/04/2026
    const CUTOFF_YEAR = 2026;
    const CUTOFF_MONTH = 4;

    let yr = date.getFullYear();
    let mo = date.getMonth() + 1;

    // If the changed date is before the cutoff, start from the cutoff instead
    if (yr < CUTOFF_YEAR || (yr === CUTOFF_YEAR && mo < CUTOFF_MONTH)) {
        yr = CUTOFF_YEAR;
        mo = CUTOFF_MONTH;
    }

    // End = the LATER of (current month) vs (date's month)
    const now = new Date();
    let endYr = now.getFullYear();
    let endMo = now.getMonth() + 1;
    const inputYr = date.getFullYear();
    const inputMo = date.getMonth() + 1;
    if (inputYr > endYr || (inputYr === endYr && inputMo > endMo)) {
        endYr = inputYr;
        endMo = inputMo;
    }

    // ── READ ONCE ──────────────────────────────────────────────────────────────
    const rawRange  = sheet.getDataRange();
    const rawValues = rawRange.getValues();

    // Build column map once
    const colMap = {};
    ["Cash", "Đã Thu", "Chi Phí", "Loại DT", "Doanh Thu Bông", "Doanh Thu Khác", "Ngày", "Khoản Thu Chi Bất Thường"]
        .forEach(n => colMap[n] = getColumnIdx(headers, n));

    const colCash = colMap["Cash"];
    const colNgay = colMap["Ngày"];
    if (colCash === -1 || colNgay === -1) return;

    // ── PRE-INDEX ALL ROWS BY MONTH ─────────────────────────────────────────────
    const rowsByMonth = {}; // Key: "YYYY-M", Value: Array of { rowIdx, date, values }
    const allHistoricalRows = []; // Array of { rowIdx, date, cash }

    for (let i = 1; i < rawValues.length; i++) {
        const d = parseDisplayDate(rawValues[i][colNgay]);
        if (!d) continue;

        const rowYr = d.getFullYear();
        const rowMo = d.getMonth() + 1;
        const key = `${rowYr}-${rowMo}`;

        if (!rowsByMonth[key]) {
            rowsByMonth[key] = [];
        }
        rowsByMonth[key].push({
            rowIdx: i,
            date: d,
            values: rawValues[i]
        });

        const cashVal = parseFloat(rawValues[i][colCash]);
        allHistoricalRows.push({
            rowIdx: i,
            date: d,
            cash: isNaN(cashVal) ? 0 : cashVal
        });
    }

    // Sort allHistoricalRows by date then rowIdx to correctly find chronological order
    allHistoricalRows.sort((a, b) => a.date - b.date || a.rowIdx - b.rowIdx);

    // Collect ALL cash updates across ALL months into one map: rowIndex → newCashValue
    const allUpdates = {}; // key: 0-based row index in rawValues

    let runningBalance = undefined;

    while (yr < endYr || (yr === endYr && mo <= endMo)) {
        // Determine opening balance for the start month if runningBalance is not set yet
        if (runningBalance === undefined) {
            let openingBalance = 0;
            const targetStartDate = new Date(yr, mo - 1, 1);
            // Find latest cash row before the target month
            for (let i = allHistoricalRows.length - 1; i >= 0; i--) {
                if (allHistoricalRows[i].date < targetStartDate) {
                    openingBalance = allHistoricalRows[i].cash;
                    break;
                }
            }
            runningBalance = openingBalance;
        }

        const monthRows = rowsByMonth[`${yr}-${mo}`] || [];
        runningBalance = recalculateMonthCash(
            monthRows, colMap, runningBalance, allUpdates
        );

        mo++;
        if (mo > 12) { mo = 1; yr++; }
    }

    // ── WRITE ONCE ─────────────────────────────────────────────────────────────
    if (Object.keys(allUpdates).length === 0) return;

    const cashCol = sheet.getRange(1, colCash + 1, rawValues.length, 1).getValues();
    for (const rowIdx in allUpdates) {
        cashCol[rowIdx][0] = allUpdates[rowIdx];
    }
    sheet.getRange(1, colCash + 1, rawValues.length, 1).setValues(cashCol);
}

/**
 * Calculates Cash balances for a given month rows.
 * Returns the closing balance of this month.
 */
function recalculateMonthCash(monthRows, colMap, openingBalance, allUpdates) {
    if (monthRows.length === 0) return openingBalance;

    // 1. Sort by date then row order
    monthRows.sort((a, b) => a.date - b.date || a.rowIdx - b.rowIdx);

    // 2. Calculate and collect updates
    const cPaid = colMap["Đã Thu"]   > -1 ? colMap["Đã Thu"]   : 8;
    const cExp  = colMap["Chi Phí"]  > -1 ? colMap["Chi Phí"]  : 13;
    const cLoai = colMap["Loại DT"];
    const cOth  = colMap["Doanh Thu Khác"] > -1 ? colMap["Doanh Thu Khác"] : 11;
    const cAdj  = colMap["Khoản Thu Chi Bất Thường"] > -1 ? colMap["Khoản Thu Chi Bất Thường"] : 17;

    let running = openingBalance;
    for (const row of monthRows) {
        const loaiDT = String(row.values[cLoai] || "").trim();
        const valR   = parseFloat(row.values[cAdj]) || 0;

        if (loaiDT === "ADJ") {
            running += valR;
        } else {
            const valI = parseFloat(row.values[cPaid]) || 0;
            running += valI;
            if (loaiDT === "Company") {
                const valOther = parseFloat(row.values[cOth]) || 0;
                if (valOther !== valI) running += valOther;
            }
            running -= (parseFloat(row.values[cExp]) || 0);
            running += valR;
        }
        allUpdates[row.rowIdx] = running;
    }

    return running;
}


