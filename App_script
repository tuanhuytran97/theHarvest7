/**
 * Fetch Stock Prices from VNDirect API
 * @param {Array} symbols
 * @returns {Object} { "VNM": 68000, ... }
 */
function fetchVnStockPrices(symbols) {
  const prices = {};
  if (!symbols || symbols.length === 0) return prices;
  
  // Try TCBS API (Sieu on dinh)
  symbols.forEach(s => {
    try {
      const urlTCBS = "https://api-price.tcbs.com.vn/stock/info?symbol=" + s;
      const res = UrlFetchApp.fetch(urlTCBS, { "muteHttpExceptions": true });
      if (res.getResponseCode() === 200) {
        const json = JSON.parse(res.getContentText());
        // TCBS returns lastPrice as full value (e.g. 61300) or thousands (61.3)
        let p = json.lastPrice || json.closePrice || json.price || 0;
        if (p > 0 && p < 1000) p *= 1000;
        if (p > 0) prices[s] = p;
      }
    } catch(e) {}
  });

  // Try SSI iBoard API (Fallback 1)
  if (Object.keys(prices).length < symbols.length) {
    try {
      const urlSSI = "https://iboard-query.ssi.com.vn/stock/config/all";
      const resSSI = UrlFetchApp.fetch(urlSSI, { "muteHttpExceptions": true });
      if (resSSI.getResponseCode() === 200) {
        const fullData = JSON.parse(resSSI.getContentText());
        if (fullData && fullData.data) {
          symbols.forEach(s => {
            if (!prices[s]) {
              const match = fullData.data.find(item => item.s === s);
              if (match && match.l) { // l is last price
                 let p = match.l;
                 if (p < 1000) p *= 1000;
                 prices[s] = p;
              }
            }
          });
        }
      }
    } catch(e) {}
  }

  // Final Try: VNDirect V4 (Fallback 2)
  if (Object.keys(prices).length < symbols.length) {
    try {
      const remaining = symbols.filter(s => !prices[s]);
      const urlVND = "https://finfo-api.vndirect.com.vn/v4/stock_prices?symbols=" + remaining.join(",");
      const resVND = UrlFetchApp.fetch(urlVND, { "muteHttpExceptions": true });
      if (resVND.getResponseCode() === 200) {
        const json = JSON.parse(resVND.getContentText());
        if (json && json.data) {
          json.data.forEach(item => {
            let p = item.lastPrice || item.basicPrice || 0;
            if (p > 0 && p < 1000) p *= 1000;
            if (p > 0) prices[item.symbol] = p;
          });
        }
      }
    } catch(e) {}
  }

  return prices;
}

/**
 * Helper to parse date strings (DD/MM/YYYY) or Date objects from Sheets
 */
function parseDisplayDate(val) {
  if (!val) return null;
  if (val instanceof Date) return val;
  const s = String(val).trim();
  
  // Handle DD/MM/YYYY or DD-MM-YYYY or YYYY-MM-DD
  const parts = s.split(/[\/\-]/);
  if (parts.length === 3) {
    if (parts[0].length === 4) { // YYYY-MM-DD
       return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    }
    const day = parseInt(parts[0], 10);
    const month = parseInt(parts[1], 10) - 1;
    let year = parseInt(parts[2], 10);
    if (year < 100) year += 2000;
    return new Date(year, month, day);
  }
  
  // Fallback for other formats
  const d = new Date(s);
  if (d && !isNaN(d.getTime())) {
    if (d.getFullYear() < 100) d.setFullYear(d.getFullYear() + 2000);
    return d;
  }
  return null;
}
