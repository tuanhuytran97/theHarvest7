const SHEET_NAME = "Data";
const CONFIG_SHEET_NAME = "Config";
const FINANCIAL_REPORT_SHEET = "FinancialReport";
const TODO_SHEET_NAME = "ToDoTracker";

function doPost(e) {
    try {
        const params = JSON.parse(e.postData.contents);
        const action = params.action;

        // 1. ĐĂNG NHẬP
        if (action === "login") {
            var password = params.password;
            if (password === "huytran97") return returnJson({ "status": "success", "role": "ADMIN" });
            else if (password === "nth66")   return returnJson({ "status": "success", "role": "EMP_LV1" });
            else if (password === "haitran63")   return returnJson({ "status": "success", "role": "EMP_LV2" });
            else return returnJson({ "status": "error", "message": "Mật khẩu không đúng!" });
        }

        // 2. KIỂM TRA TOKEN
        const token = params.token;
        const validTokens = ["huytran97", "nth66", "haitran63"];
        if (!token || validTokens.indexOf(token) === -1)
            return returnJson({ "status": "error", "message": "Phiên làm việc hết hạn hoặc không có quyền!" });

        // 3. KẾT NỐI SHEET DATA
        const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
        if (!sheet) return returnJson({ "status": "error", "message": "Không tìm thấy Sheet: " + SHEET_NAME });

        const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
        const data = params.data;

        // Tự động phân loại "Vật tư KD" nếu dữ liệu có chứa từ khóa này (Không phân biệt hoa thường)
        const checkTarget = data || params.updates;
        if (checkTarget && JSON.stringify(checkTarget).toLowerCase().includes("vật tư kd")) {
            if (data) data["Loại CP"] = "Vật tư KD";
            if (params.updates) params.updates["Loại CP"] = "Vật tư KD";
        }

        // 4. CONFIG ACTIONS
        if (action === "get_config") {
            return returnJson({ "status": "success", "config": readConfig() });

        } else if (action === "save_config") {
            if (token !== "huytran97") return returnJson({ "status": "error", "message": "Chỉ ADMIN mới có thể thay đổi cấu hình!" });
            writeConfig(params.key, params.value);
            return returnJson({ "status": "success" });

        } else if (action === "save_adjustment") {
            const displayValues = sheet.getDataRange().getDisplayValues();
            const colNgay    = getColumnIdx(headers, "Ngày");
            const colStatus  = getColumnIdx(headers, "Status");
            const colLoaiDT  = getColumnIdx(headers, "Loại DT");
            const colDTBong  = getColumnIdx(headers, "Doanh Thu Bông");
            const colAdjVal  = getColumnIdx(headers, "Khoản Thu Chi Bất Thường");
            const colAdjNote = getColumnIdx(headers, "Ghi Chú Thu Chi Bất Thường");
            
            const idxR = colAdjVal > -1 ? colAdjVal : 17;
            const idxS = colAdjNote > -1 ? colAdjNote : 18;

            let rowIndexToFill = -1;
            for (let i = displayValues.length - 1; i >= Math.max(1, displayValues.length - 10); i--) {
                 if (displayValues[i][colNgay] === data["Ngày"] && 
                     String(displayValues[i][idxR]) === String(data["amount"]) && 
                     displayValues[i][idxS] === data["Ghi Chú"]) {
                     return returnJson({ "status": "success", "message": "Duplicate skipped" });
                 }
            }

            for (let i = displayValues.length - 1; i >= 1; i--) {
                if (displayValues[i][colNgay] === data["Ngày"]) {
                    if (displayValues[i][idxR] === "" || displayValues[i][idxR] === "0") {
                        rowIndexToFill = i + 1;
                        break;
                    }
                }
            }

            if (rowIndexToFill > -1) {
                sheet.getRange(rowIndexToFill, idxR + 1).setValue(parseFloat(data["amount"]) || 0);
                sheet.getRange(rowIndexToFill, idxS + 1).setValue(data["Ghi Chú"] || "");
            } else {
                const adjRow = new Array(headers.length).fill("");
                adjRow[colNgay]   = data["Ngày"] || "";
                if (colStatus > -1) adjRow[colStatus] = "Xong";
                adjRow[idxR]      = parseFloat(data["amount"]) || 0;
                adjRow[idxS]      = data["Ghi Chú"] || "";
                if (colLoaiDT > -1) adjRow[colLoaiDT] = "";
                if (colDTBong > -1) adjRow[colDTBong] = "";
                sheet.appendRow(adjRow);
            }

            const adjDate = parseDisplayDate(data["Ngày"]);
            if (adjDate) recalculateFromDate(sheet, headers, adjDate);

            return returnJson({ "status": "success" });



        // 5. MUTATION ACTIONS
        } else if (action === "add") {
            const displayValues = sheet.getDataRange().getDisplayValues();
            let rowIndexToFill = -1;
            const colNgay   = getColumnIdx(headers, "Ngày");
            const colLoaiDT = getColumnIdx(headers, "Loại DT");
            const colSL     = getColumnIdx(headers, "Số lượng");

            const isVuaEntry = String(data["Loại DT"]).trim() === "V\u1ef1a";

            // Nếu KHÔNG phải đơn Vựa, mới tìm dòng trống để điền vào
            if (!isVuaEntry) {
                for (let i = displayValues.length - 1; i >= 1; i--) {
                    if (displayValues[i][colNgay] === String(data["Ngày"]) &&
                        displayValues[i][colLoaiDT] === "" &&
                        (displayValues[i][colSL] === "" || displayValues[i][colSL] === "0")) {
                        rowIndexToFill = i + 1;
                        break;
                    }
                }
            }

            if (rowIndexToFill > -1) {
                headers.forEach((h, idx) => {
                    const normH = normalizeString(h);
                    if (normH === "status") {
                        sheet.getRange(rowIndexToFill, idx + 1).setValue(data[h] || data["Status"] || "");
                    } else {
                        // Tìm data key khớp với h (không phân biệt hoa thường)
                        let val = data[h];
                        if (val === undefined) {
                           const matchKey = Object.keys(data).find(k => normalizeString(k) === normH);
                           if (matchKey) val = data[matchKey];
                        }
                        if (val !== undefined && val !== null && val !== "") {
                           sheet.getRange(rowIndexToFill, idx + 1).setValue(val);
                        }
                    }
                });
            } else {
                // Tìm vị trí chèn đúng thứ tự ngày trong Sheet
                // Logic: chèn sau hàng cuối cùng có cùng ngày,
                //        hoặc trước hàng đầu tiên có ngày lớn hơn (mới hơn),
                //        hoặc appendRow nếu không có hàng nào phù hợp
                const targetDate = parseDisplayDate(String(data["Ngày"]));
                let insertAfterRow = -1; // 1-indexed, chèn sau dòng này

                if (targetDate) {
                    // Duyệt từ cuối lên để tìm vị trí chèn phù hợp
                    for (let i = displayValues.length - 1; i >= 1; i--) {
                        const rowDate = parseDisplayDate(displayValues[i][colNgay]);
                        if (!rowDate) continue;

                        if (rowDate <= targetDate) {
                            // Chèn sau dòng này (dòng có ngày <= ngày mới)
                            insertAfterRow = i + 1; // 1-indexed sheet row
                            break;
                        }
                    }
                }

                const newRowData = headers.map(h => {
                    const normH = normalizeString(h);
                    let val = data[h];
                    if (val === undefined) {
                        const matchKey = Object.keys(data).find(k => normalizeString(k) === normH);
                        if (matchKey) val = data[matchKey];
                    }
                    return val || "";
                });

                if (insertAfterRow > 0 && insertAfterRow < displayValues.length + 1) {
                    // Insert row sau vị trí tìm được rồi điền dữ liệu
                    sheet.insertRowAfter(insertAfterRow);
                    const newRange = sheet.getRange(insertAfterRow + 1, 1, 1, headers.length);
                    newRange.setValues([newRowData]);
                } else {
                    // Fallback: append cuối
                    sheet.appendRow(newRowData);
                }
            }

            const d = parseDisplayDate(data["Ngày"]);
            if (d) recalculateFromDate(sheet, headers, d);
            return returnJson({ "status": "success" });

        } else if (action === "deleteByRow") {
            const rowNumber = parseInt(params.rowNumber);
            const context = params.context || "all"; // all, adjustment, expense
            if (!rowNumber || rowNumber < 2) return returnJson({ "status": "error", "message": "Dòng không hợp lệ" });

            const displayBefore = sheet.getDataRange().getDisplayValues();
            const colNgayD = headers.indexOf("Ngày");
            const rowDateStr = rowNumber <= displayBefore.length ? displayBefore[rowNumber - 1][colNgayD] : null;

            if (context === "all") {
                sheet.deleteRow(rowNumber);
            } else {
                // Partial delete logic: Clear specific fields instead of whole row if borrowed
                const colAdjVal  = getColumnIdx(headers, "Khoản Thu Chi Bất Thường");
                const colAdjNote = getColumnIdx(headers, "Ghi Chú Thu Chi Bất Thường");
                const colChiPhi  = getColumnIdx(headers, "Chi Phí");
                const colLoaiCP  = getColumnIdx(headers, "Loại CP");
                const colNoteCP  = getColumnIdx(headers, "Ghi Chú Chi Phí") > -1 ? getColumnIdx(headers, "Ghi Chú Chi Phí") : getColumnIdx(headers, "Ghi Chú Chi Phí2");
                const colSL      = getColumnIdx(headers, "Số lượng");
                const colLoaiDT  = getColumnIdx(headers, "Loại DT");

                if (context === "adjustment") {
                    if (colAdjVal > -1) sheet.getRange(rowNumber, colAdjVal + 1).clearContent();
                    if (colAdjNote > -1) sheet.getRange(rowNumber, colAdjNote + 1).clearContent();
                } else if (context === "expense") {
                    if (colChiPhi > -1) sheet.getRange(rowNumber, colChiPhi + 1).clearContent();
                    if (colLoaiCP > -1) sheet.getRange(rowNumber, colLoaiCP + 1).clearContent();
                    if (colNoteCP > -1) sheet.getRange(rowNumber, colNoteCP + 1).clearContent();
                }

                // Check if row is now empty of significant data
                const updatedRow = sheet.getRange(rowNumber, 1, 1, headers.length).getValues()[0];
                let hasData = false;
                if (colSL > -1 && String(updatedRow[colSL]).trim() !== "" && String(updatedRow[colSL]) !== "0") hasData = true;
                if (colChiPhi > -1 && String(updatedRow[colChiPhi]).trim() !== "" && String(updatedRow[colChiPhi]) !== "0") hasData = true;
                if (colAdjVal > -1 && String(updatedRow[colAdjVal]).trim() !== "" && String(updatedRow[colAdjVal]) !== "0") hasData = true;
                if (colLoaiDT > -1 && String(updatedRow[colLoaiDT]).trim() !== "") hasData = true;


                if (!hasData) {
                    sheet.deleteRow(rowNumber);
                }
            }

            const d = parseDisplayDate(rowDateStr);
            if (d) recalculateFromDate(sheet, headers, d);
            return returnJson({ "status": "success" });


        } else if (action === "add_expense") {
            const displayValues = sheet.getDataRange().getDisplayValues();
            let rowIndexToFill = -1;
            const colNgay    = getColumnIdx(headers, "Ngày");
            const colLoaiDT  = getColumnIdx(headers, "Loại DT");
            const colChiPhi  = getColumnIdx(headers, "Chi Phí");

            for (let i = displayValues.length - 1; i >= 1; i--) {
                if (displayValues[i][colNgay] === data["Ngày"] &&
                    displayValues[i][colLoaiDT] !== "Vựa" &&
                    (displayValues[i][colChiPhi] === "" || displayValues[i][colChiPhi] === "0")) {
                    rowIndexToFill = i + 1;
                    break;
                }
            }

            if (rowIndexToFill > -1) {
                sheet.getRange(rowIndexToFill, colChiPhi + 1).setValue(data["Chi Phí"]);
                const idxLoaiCP = getColumnIdx(headers, "Loại CP");
                if (idxLoaiCP > -1) sheet.getRange(rowIndexToFill, idxLoaiCP + 1).setValue(data["Loại CP"]);
                const idxNote = getColumnIdx(headers, "Ghi Chú Chi Phí");
                const idxNote2 = getColumnIdx(headers, "Ghi Chú Chi Phí2");
                const finalIdxNote = idxNote > -1 ? idxNote : idxNote2;
                if (finalIdxNote > -1) sheet.getRange(rowIndexToFill, finalIdxNote + 1).setValue(data["Ghi Chú Chi Phí"] || data["Ghi Chú Chi Phí2"] || "");
            } else {
                const targetDate = parseDisplayDate(String(data["Ngày"]));
                let insertAfterRow = -1;

                if (targetDate) {
                    for (let i = displayValues.length - 1; i >= 1; i--) {
                        const rowDate = parseDisplayDate(displayValues[i][colNgay]);
                        if (!rowDate) continue;

                        if (rowDate <= targetDate) {
                            insertAfterRow = i + 1;
                            break;
                        }
                    }
                }

                const newRow = headers.map(h => {
                    const normH = normalizeString(h);
                    if (normH === "status") return "Xong";
                    if (normH === "ghi chu chi phi" || normH === "ghi chu chi phi2") {
                        return data["Ghi Chú Chi Phí"] || data["Ghi Chú Chi Phí2"] || "";
                    }
                    let val = data[h];
                    if (val === undefined) {
                        const matchKey = Object.keys(data).find(k => normalizeString(k) === normH);
                        if (matchKey) val = data[matchKey];
                    }
                    return val || "";
                });

                if (insertAfterRow > 0 && insertAfterRow < displayValues.length + 1) {
                    sheet.insertRowAfter(insertAfterRow);
                    const newRange = sheet.getRange(insertAfterRow + 1, 1, 1, headers.length);
                    newRange.setValues([newRow]);
                } else {
                    sheet.appendRow(newRow);
                }
            }

            const d = parseDisplayDate(data["Ngày"]);
            if (d) recalculateFromDate(sheet, headers, d);
            return returnJson({ "status": "success" });

        } else if (action === "update") {
            const rowNumber = parseInt(params.rowNumber);
            const updates = params.updates;
            let updatedRowDate = null;

            if (rowNumber && rowNumber >= 2) {
                for (let key in updates) {
                    const colIdx = getColumnIdx(headers, key);
                    if (colIdx > -1) sheet.getRange(rowNumber, colIdx + 1).setValue(updates[key]);
                }
                const dispVals = sheet.getDataRange().getDisplayValues();
                updatedRowDate = dispVals[rowNumber - 1][headers.indexOf("Ngày")];
            } else {
                const targetRow = params.targetRow;
                const values = sheet.getDataRange().getValues();
                const dispVals = sheet.getDataRange().getDisplayValues();
                const colNgay = headers.indexOf("Ngày");
                const colNguoiMua = headers.indexOf("Người Mua");
                const colLoaiHoa  = headers.indexOf("Loại Hoa");

                for (let i = values.length - 1; i >= 1; i--) {
                    if (String(values[i][colNgay]) === String(targetRow["Ngày"]) &&
                        String(values[i][colNguoiMua]) === String(targetRow["Người Mua"] || "") &&
                        String(values[i][colLoaiHoa]) === String(targetRow["Loại Hoa"] || "")) {
                        for (let key in updates) {
                            const colIdx = getColumnIdx(headers, key);
                            if (colIdx > -1) sheet.getRange(i + 1, colIdx + 1).setValue(updates[key]);
                        }
                        updatedRowDate = dispVals[i][colNgay];
                        break;
                    }
                }
            }

            if (updatedRowDate) {
                const d = parseDisplayDate(updatedRowDate);
                if (d) recalculateFromDate(sheet, headers, d);
                return returnJson({ "status": "success" });
            }
            return returnJson({ "status": "error", "message": "Không tìm thấy dòng để cập nhật" });

        } else if (action === "bulkPay") {
            const buyer = (params.buyerName || "").trim();
            const dateStr   = params.dateStr;
            const isAllDates = params.isAllDates;
            const now = new Date();
            const fullDateTimeStr = Utilities.formatDate(now, "GMT+7", "dd/MM/yyyy HH:mm:ss");
            const todayStr = Utilities.formatDate(now, "GMT+7", "dd/MM/yyyy");

            const rawValues  = sheet.getDataRange().getValues();
            const dispValues = sheet.getDataRange().getDisplayValues();

            const colNgay        = headers.indexOf("Ngày");
            const colStatus      = headers.indexOf("Status");
            const colNguoiMua    = headers.indexOf("Người Mua");
            const colDaThu       = headers.indexOf("Đã Thu");
            const colGhiChu      = headers.indexOf("Ghi Chú");
            const colDTBong      = headers.indexOf("Doanh Thu Bông");
            const colTienPhaiThu = headers.indexOf("Tiền Phải Thu");
            const colLoaiDT      = headers.indexOf("Loại DT");

            let updateCount = 0;
            let totalToPay = 0;
            let lastLoaiDT = "Farm"; 
            const touchedMonths = new Set();

            for (let i = 1; i < rawValues.length; i++) {
                if (String(rawValues[i][colNguoiMua]).trim() === buyer &&
                    String(rawValues[i][colStatus]).trim().toLowerCase() !== "xong") {
                    
                    var isMatched = isAllDates || 
                        (dispValues[i][colNgay] === dateStr) ||
                        (typeof dateStr === "string" && dateStr.split(",").map(function(s) { return s.trim(); }).indexOf(dispValues[i][colNgay]) > -1) ||
                        (Array.isArray(dateStr) && dateStr.indexOf(dispValues[i][colNgay]) > -1);

                    if (isMatched) {
                        // 1. Calculate remaining debt for this row
                        let revenue = 0;
                        const loaiDTValue = colLoaiDT > -1 ? String(rawValues[i][colLoaiDT]).trim() : "";
                        if (loaiDTValue === "Vựa") {
                            revenue = parseFloat(rawValues[i][colTienPhaiThu]) || 0;
                            lastLoaiDT = "Vựa";
                        } else {
                            revenue = parseFloat(rawValues[i][colDTBong]) || 0;
                            lastLoaiDT = "Farm";
                        }
                        const paid = parseFloat(rawValues[i][colDaThu]) || 0;
                        totalToPay += (revenue - paid);

                        // 2. Mark old row as "Xong" but DO NOT add money here
                        sheet.getRange(i + 1, colStatus + 1).setValue("Xong");
                        if (colGhiChu > -1) {
                            const oldNote = rawValues[i][colGhiChu] || "";
                            const noteSuffix = " [Chốt thanh toán ngày " + todayStr + "]";
                            sheet.getRange(i + 1, colGhiChu + 1).setValue(oldNote + (oldNote ? " | " : "") + noteSuffix);
                        }

                        const d = parseDisplayDate(dispValues[i][colNgay]);
                        if (d) touchedMonths.add(`${d.getFullYear()}-${d.getMonth() + 1}`);
                        updateCount++;
                    }
                }
            }

            // 3. Append NEW row for the actual cash flow in the current month
            if (totalToPay > 0) {
                const newRow = new Array(headers.length).fill("");
                newRow[colNgay] = todayStr;
                newRow[colNguoiMua] = buyer;
                newRow[colDaThu] = totalToPay;
                newRow[colStatus] = "Xong";
                newRow[colGhiChu] = params.customNote || ("Thanh toán hết ngày " + todayStr);
                if (colLoaiDT > -1) newRow[colLoaiDT] = lastLoaiDT;
                
                sheet.appendRow(newRow);
                touchedMonths.add(`${now.getFullYear()}-${now.getMonth() + 1}`);
            }

            // Recalculate from the earliest touched month
            let earliestDate = null;
            touchedMonths.forEach(key => {
                const [yr, mo] = key.split('-').map(Number);
                const d = new Date(yr, mo - 1, 1);
                if (!earliestDate || d < earliestDate) earliestDate = d;
            });
            if (earliestDate) recalculateFromDate(sheet, headers, earliestDate);

            return returnJson({ "status": "success", "count": updateCount, "amount": totalToPay });

        } else if (action === "settleCumulative") {
            const buyer = (params.buyerName || "").trim();
            const endDateStr = params.endDateStr; // e.g. "08/05/2026" or "08/05/26"
            const amount = parseFloat(params.amount) || 0;
            const now = new Date();
            const todayStr = Utilities.formatDate(now, "GMT+7", "dd/MM/yyyy");

            const rawValues  = sheet.getDataRange().getValues();
            const dispValues = sheet.getDataRange().getDisplayValues();

            const colNgay        = headers.indexOf("Ngày");
            const colStatus      = headers.indexOf("Status");
            const colNguoiMua    = headers.indexOf("Người Mua");
            const colDaThu       = headers.indexOf("Đã Thu");
            const colGhiChu      = headers.indexOf("Ghi Chú");
            const colLoaiDT      = headers.indexOf("Loại DT");

            let updateCount = 0;
            let oldestDateStr = "";
            let lastLoaiDT = "Farm";
            const touchedMonths = new Set();

            const endDate = parseDisplayDate(endDateStr);
            if (!endDate) return returnJson({ "status": "error", "message": "Ngày kết thúc gạch nợ không hợp lệ: " + endDateStr });

            for (let i = 1; i < rawValues.length; i++) {
                if (String(rawValues[i][colNguoiMua]).trim() === buyer) {
                    const rowDate = parseDisplayDate(dispValues[i][colNgay]);
                    if (rowDate && rowDate <= endDate) {
                        if (String(rawValues[i][colStatus]).trim().toLowerCase() !== "xong") {
                            sheet.getRange(i + 1, colStatus + 1).setValue("Xong");
                            if (colGhiChu > -1) {
                                const oldNote = rawValues[i][colGhiChu] || "";
                                const noteSuffix = " [Gạch toa lũy kế ngày " + todayStr + "]";
                                sheet.getRange(i + 1, colGhiChu + 1).setValue(oldNote + (oldNote ? " | " : "") + noteSuffix);
                            }
                            updateCount++;

                            if (!oldestDateStr || rowDate < parseDisplayDate(oldestDateStr)) {
                                oldestDateStr = dispValues[i][colNgay];
                            }
                        }

                        if (colLoaiDT > -1 && String(rawValues[i][colLoaiDT]).trim() !== "") {
                            lastLoaiDT = String(rawValues[i][colLoaiDT]).trim();
                        }
                        touchedMonths.add(`${rowDate.getFullYear()}-${rowDate.getMonth() + 1}`);
                    }
                }
            }

            if (amount > 0) {
                const newRow = new Array(headers.length).fill("");
                newRow[colNgay] = todayStr;
                newRow[colNguoiMua] = buyer;
                newRow[colDaThu] = amount;
                newRow[colStatus] = "Xong";
                
                const cleanOldestStr = oldestDateStr ? oldestDateStr.split('/').slice(0, 2).join('/') : "";
                const cleanEndStr = endDateStr ? endDateStr.split('/').slice(0, 2).join('/') : "";
                let customNote = "Gạch nợ lũy kế";
                if (cleanOldestStr && cleanEndStr) {
                    customNote += ` từ ${cleanOldestStr} đến ${cleanEndStr}`;
                } else if (cleanEndStr) {
                    customNote += ` đến ${cleanEndStr}`;
                }
                newRow[colGhiChu] = customNote;
                if (colLoaiDT > -1) newRow[colLoaiDT] = lastLoaiDT;
                
                sheet.appendRow(newRow);
                touchedMonths.add(`${now.getFullYear()}-${now.getMonth() + 1}`);
            }

            let earliestDate = null;
            touchedMonths.forEach(key => {
                const [yr, mo] = key.split('-').map(Number);
                const d = new Date(yr, mo - 1, 1);
                if (!earliestDate || d < earliestDate) earliestDate = d;
            });
            if (earliestDate) recalculateFromDate(sheet, headers, earliestDate);

            return returnJson({ "status": "success", "count": updateCount, "amount": amount });

        } else if (action === "recordPayment") {
            const buyer = (params.buyerName || "").trim();
            const amount = parseFloat(params.amount) || 0;
            const dateStr = params.dateStr; // Optional: only pay for specific date
            const isFull = params.isFull === true;
            const now = new Date();
            const todayStr = Utilities.formatDate(now, "GMT+7", "dd/MM/yyyy");

            const rawValues = sheet.getDataRange().getValues();
            const dispValues = sheet.getDataRange().getDisplayValues();
            const colNgay = headers.indexOf("Ngày");
            const colStatus = headers.indexOf("Status");
            const colNguoiMua = headers.indexOf("Người Mua");
            const colDaThu = headers.indexOf("Đã Thu");
            const colGhiChu = headers.indexOf("Ghi Chú");
            const colDTBong = headers.indexOf("Doanh Thu Bông");
            const colTienPhaiThu = headers.indexOf("Tiền Phải Thu");
            const colLoaiDT = headers.indexOf("Loại DT");

            let remainingToDistribute = amount;
            let lastLoaiDT = "Farm";
            const touchedMonths = new Set();

            // 1. Mark rows as "Xong" if covered
            for (let i = 1; i < rawValues.length; i++) {
                if (String(rawValues[i][colNguoiMua]).trim() === buyer &&
                    String(rawValues[i][colStatus]).trim().toLowerCase() !== "xong") {
                    
                    if (dateStr && dispValues[i][colNgay] !== dateStr) continue;

                    let revenue = 0;
                    const loaiDTValue = colLoaiDT > -1 ? String(rawValues[i][colLoaiDT]).trim() : "";
                    if (loaiDTValue === "Vựa") {
                        revenue = parseFloat(rawValues[i][colTienPhaiThu]) || 0;
                        lastLoaiDT = "Vựa";
                    } else {
                        revenue = parseFloat(rawValues[i][colDTBong]) || 0;
                        lastLoaiDT = "Farm";
                    }
                    const paid = parseFloat(rawValues[i][colDaThu]) || 0;
                    const debt = revenue - paid;

                    if (isFull || remainingToDistribute >= debt) {
                        sheet.getRange(i + 1, colStatus + 1).setValue("Xong");
                        if (colGhiChu > -1) {
                            const oldNote = rawValues[i][colGhiChu] || "";
                            sheet.getRange(i + 1, colGhiChu + 1).setValue(oldNote + (oldNote ? " | " : "") + "[Đã chốt thanh toán ngày " + todayStr + "]");
                        }
                        remainingToDistribute -= debt;
                    } else {
                        // Partial for this row, but we don't update Đã Thu on old rows anymore
                        // So we just leave it "Chưa Xong"
                        remainingToDistribute = 0;
                    }

                    const d = parseDisplayDate(dispValues[i][colNgay]);
                    if (d) touchedMonths.add(`${d.getFullYear()}-${d.getMonth() + 1}`);
                }
            }

            // 2. Add NEW payment row
            if (amount > 0) {
                const newRow = new Array(headers.length).fill("");
                newRow[colNgay] = todayStr;
                newRow[colNguoiMua] = buyer;
                newRow[colDaThu] = amount;
                newRow[colStatus] = "Xong";
                newRow[colGhiChu] = (isFull ? "Thanh toán hết ngày " : "Thu tiền ngày ") + todayStr;
                if (colLoaiDT > -1) newRow[colLoaiDT] = lastLoaiDT;
                sheet.appendRow(newRow);
                touchedMonths.add(`${now.getFullYear()}-${now.getMonth() + 1}`);
            }

            // 3. Recalculate
            let earliestDate = null;
            touchedMonths.forEach(key => {
                const [yr, mo] = key.split('-').map(Number);
                const d = new Date(yr, mo - 1, 1);
                if (!earliestDate || d < earliestDate) earliestDate = d;
            });
            if (earliestDate) recalculateFromDate(sheet, headers, earliestDate);

            return returnJson({ "status": "success", "amount": amount });

        // 6. FINANCIAL REPORT ACTIONS
        } else if (action === "get_financial_report") {
            const fSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FINANCIAL_REPORT_SHEET);
            if (!fSheet) return returnJson({ "status": "error", "message": "Không tìm thấy Sheet: " + FINANCIAL_REPORT_SHEET });
            
            const range = fSheet.getDataRange();
            const values = range.getValues();
            const notes = fSheet.getRange(1, 1, 1, values[0].length).getNotes()[0]; // Lấy ghi chú của dòng tiêu đề (Năm)
            
            // Trả về kèm ghi chú để xác định trạng thái Lock
            return returnJson({ "status": "success", "data": values, "notes": notes });

        } else if (action === "save_financial_report") {
            const fSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FINANCIAL_REPORT_SHEET);
            if (!fSheet) return returnJson({ "status": "error", "message": "Không tìm thấy Sheet: " + FINANCIAL_REPORT_SHEET });
            
            // params: { yearIndex: 1, rowIndex: 5, value: 500000 }
            const rIdx = parseInt(params.rowIndex) + 1;
            const cIdx = parseInt(params.yearIndex) + 1;
            
            if (rIdx < 1 || cIdx < 1) return returnJson({ "status": "error", "message": "Vị trí dữ liệu không hợp lệ" });
            
            fSheet.getRange(rIdx, cIdx).setValue(params.value);
            return returnJson({ "status": "success" });

        } else if (action === "lock_financial_year") {
            if (token !== "huytran97") return returnJson({ "status": "error", "message": "Chỉ ADMIN mới có quyền khóa dữ liệu!" });
            
            const fSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(FINANCIAL_REPORT_SHEET);
            if (!fSheet) return returnJson({ "status": "error", "message": "Không tìm thấy Sheet: " + FINANCIAL_REPORT_SHEET });
            
            // Sử dụng Ghi chú (Note) ở dòng 1 để lưu trạng thái Lock, tránh làm hỏng công thức Sum của USER
            const cIdx = parseInt(params.yearIndex) + 1;
            const headerCell = fSheet.getRange(1, cIdx);
            if (params.isLocked) {
                headerCell.setNote("LOCKED");
            } else {
                headerCell.clearNote();
            }
            
            return returnJson({ "status": "success" });
        } else if (action === "get_investment_data") {
